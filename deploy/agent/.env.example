# =============================================================================
# Vibe Kanban Agent Daemon - 环境变量
# =============================================================================
# 从 Web UI 创建服务器后，将获取的信息填入此文件
# =============================================================================

# ---- 必填：中心服务器 WebSocket URL ----
# 从 Web UI 的 Docker 命令中复制
CENTER_URL=ws://your-center-server:3000/v1/agent/ws

# ---- 必填：Agent Token ----
# 从 Web UI 创建服务器后获取
AGENT_TOKEN=vk_agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选配置 ----
LOG_LEVEL=info
HEARTBEAT_INTERVAL=30

# ---- 可选：目录配置 ----
# WORKSPACE_DIR=./workspaces
# CONFIG_DIR=./config
# LOG_DIR=./logs
# SSH_DIR=~/.ssh
