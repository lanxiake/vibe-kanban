# =============================================================================
# Vibe Kanban AI Tool Orchestration Platform - 部署环境变量
# =============================================================================
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
#   vim .env
# =============================================================================

# ---- 必填：数据库 ----
POSTGRES_PASSWORD=changeme_use_a_strong_password

# ---- 必填：JWT 密钥 ----
# Base64 编码，至少 32 字节。生成方式：
#   openssl rand -base64 48
VIBEKANBAN_REMOTE_JWT_SECRET=

# ---- 必填：ElectricSQL 角色密码 ----
# 生成方式：openssl rand -hex 16
ELECTRIC_ROLE_PASSWORD=

# ---- 必填：OAuth 认证（至少配置一个） ----
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ---- 必填：邮件服务 ----
# Loops: https://app.loops.so
LOOPS_EMAIL_API_KEY=

# ---- 必填：公共访问 URL ----
# 替换为你的服务器实际域名和端口
SERVER_PUBLIC_BASE_URL=http://your-server-ip:3000

# ---- 必填：Agent WebSocket URL ----
# Agent Daemon 通过此 URL 连接到中心服务器
# 格式：ws://<server-ip>:<port>/v1/agent/ws
CENTER_WS_URL=ws://your-server-ip:3000/v1/agent/ws

# ---- 必填：Token 哈希密钥 ----
# 用于 HMAC-SHA256 哈希 Agent Token。生成方式：
#   openssl rand -hex 32
TOKEN_HASH_SECRET=

# ---- 可选：日志级别 ----
RUST_LOG=info,remote=info

# ---- 可选：R2 对象存储 ----
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REVIEW_ENDPOINT=
# R2_REVIEW_BUCKET=

# ---- 可选：GitHub App 集成 ----
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# ---- 可选：PostHog 分析 ----
# POSTHOG_API_KEY=
# POSTHOG_API_ENDPOINT=

# ---- 可选：Stripe 计费 ----
# STRIPE_SECRET_KEY=
# STRIPE_TEAM_SEAT_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
